{
  "root": "Reply",
  "components": {
    "Reply": {
      "signature": "Reply(children: (Text | EmailList | BillList | DraftPreview | StatRow | Actions)[])",
      "description": "Root of every UI answer."
    },
    "Text": {
      "signature": "Text(text: string)",
      "description": "A short paragraph of plain prose."
    },
    "EmailList": {
      "signature": "EmailList(title?: string, items: EmailCard[])",
      "description": "A list of emails, e.g. search results or threads waiting on a reply."
    },
    "EmailCard": {
      "signature": "EmailCard(from: string, subject: string, date: string, summary: string, threadId: string, tag?: string)",
      "description": "One email or thread."
    },
    "BillList": {
      "signature": "BillList(title?: string, items: Bill[])",
      "description": "Bills or payments that are due."
    },
    "Bill": {
      "signature": "Bill(payee: string, amount: string, currency: string, due: string, threadId: string)",
      "description": "One bill or payment due."
    },
    "DraftPreview": {
      "signature": "DraftPreview(to: string, subject: string, body: string)",
      "description": "A reply draft that was saved to Gmail Drafts. Use only after create_draft succeeded."
    },
    "StatRow": {
      "signature": "StatRow(items: Stat[])",
      "description": "A row of quick counts."
    },
    "Stat": {
      "signature": "Stat(label: string, value: string)",
      "description": "One labelled count."
    },
    "Actions": {
      "signature": "Actions(items: ActionButton[])",
      "description": "A row of follow-up buttons (at most 3)."
    },
    "ActionButton": {
      "signature": "ActionButton(label: string, prompt: string)",
      "description": "A follow-up suggestion. Clicking sends `prompt` as the user's next message."
    }
  },
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "Reply": {
        "$ref": "#/$defs/Reply"
      },
